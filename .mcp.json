{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking",
        "--scope",
        "project"
      ],
      "env": {}
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "shrimp-task-manager": {
        "command": "node",
        "args": ["/Users/Kang/workspace/mcp-shrimp-task-manager/dist/index.js"],
        "env": {
          "DATA_DIR": "/Users/Kang/workspace/courses/notion-cms-project/shrimp_data",
          "TEMPLATES_USE": "en",
          "ENABLE_GUI": "false"
        }
      }
  }
}