# Notion API 키 (https://www.notion.so/my-integrations 에서 발급)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 데이터베이스 ID (32자리 hex 문자열)
# 데이터베이스 URL: https://www.notion.so/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
# URL에서 ? 앞의 32자리 문자열이 DATABASE_ID
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
